NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_AQUI
ROUTING_BASE_URL=https://router.project-osrm.org
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@SEU-DOMINIO
PUSH_DISPATCH_SECRET=
# Segredo independente, aleatório e com pelo menos 32 caracteres; só servidor/agendador.
MARKETPLACE_DISPATCH_SECRET=
# Sem modo ou atestação no banco, Compras permanece fechada.
MARKETPLACE_OPERATION_MODE=
# Use em Supabase isolado (`isolated_test`) e nunca com o banco de produção.
MARKETPLACE_TEST_SUPABASE_URL=
MARKETPLACE_TEST_ENVIRONMENT_ID=
# Exclusivos da Vercel Production. Prepare o registro no banco desabilitado.
# Configurar essas variáveis não libera Compras; a abertura é separada.
MARKETPLACE_PRODUCTION_SUPABASE_URL=
MARKETPLACE_PRODUCTION_ENVIRONMENT_ID=
PIX_PROVIDER=
# Adicione aqui apenas no servidor as credenciais exigidas pelo provedor Pix escolhido.
